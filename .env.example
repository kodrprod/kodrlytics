# OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_key_here

# LLM model for extraction and narrative. Default: free tier for development.
# For production with real data, use a paid model with no-logging policy.
MODEL_NAME=meta-llama/llama-3.1-8b-instruct:free
FALLBACK_MODEL=mistralai/mistral-7b-instruct:free

# DATA_MODE controls data protection:
#   test  — free models allowed, responses cached in dev.db
#   real  — free models BLOCKED, requires paid model with no-logging
DATA_MODE=test
